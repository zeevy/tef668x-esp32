# Formatting for tef668x-esp32.
#
# Two space indent, never a tab, K&R braces and eighty columns, the house
# style, which is Google's own. So only the differences from Google are
# listed below.
#
# The version is pinned, because versions format this tree differently:
#   python3 -m pip install --break-system-packages clang-format==23.1.1
#
# Check the tree with `tools/check.sh format`, which refuses any other version.
# Fix it with:
#   clang-format -i $(find src test -name '*.c' -o -name '*.cpp' -o -name '*.h')
---
BasedOnStyle: Google
Language: Cpp

TabWidth: 2

# A single statement body still gets braces, so adding a second line later
# cannot silently fall outside the if.
InsertBraces: true

# Pointers and references bind to the name, which is what the existing code
# does: char *name, not char* name.
PointerAlignment: Right

# Keep the include order stable rather than clever. Grouping is by category
# and each group is sorted, which makes a missing include obvious.
IncludeBlocks: Preserve

# Do not reflow comment text. The prose is wrapped deliberately.
ReflowComments: false

# Short things stay on one line only when they were written that way.
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
